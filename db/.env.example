# Copy to db/.env and set a real password. db/.env is gitignored.
#
#   cp db/.env.example db/.env
#
# db/.env is read by BOTH `docker compose -f db/docker-compose.yml` (automatically,
# because it sits beside the compose file) and by db/migrate.mjs.

POSTGRES_DB=redbot
POSTGRES_USER=redbot

# Required — the compose file refuses to start without it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# Host port. The container always listens on 5432 internally; this is the loopback
# port it is published on. Change it if something else already owns 5432.
POSTGRES_PORT=5432

# Loopback port for the pgweb database viewer, which is opt-in:
#
#   docker compose -f db/docker-compose.yml --profile tools up -d
#   http://127.0.0.1:8081
#
# It auto-connects with the credentials above, so anything that can reach this
# port can read the database without being asked for a password. That is why it
# is bound to 127.0.0.1 and why it is not started by a plain `up -d`.
PGWEB_PORT=8081

# ---------------------------------------------------------------------------
# The credentials vault (redbot.credentials, src/vault.ts).
#
# 32 bytes, hex or base64. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# This is the key to every secret redbot has stored. It lives HERE, in a gitignored
# file beside the database password, and deliberately NOT in the database — that is
# the whole reason a dump of redbot.credentials is worthless to whoever takes it.
#
# Back it up somewhere the database backups are not. Lose it and every sealed secret
# is unrecoverable; `redbot vault list` will show them as sealed under a key you no
# longer hold. Rotating it does not re-seal existing rows: store them again.
REDBOT_VAULT_KEY=
