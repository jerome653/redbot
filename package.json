{
  "name": "redbot",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "description": "redbot MVP — assists a human engaging on Reddit through a real browser session. One account, one profile, local-first.",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "redbot": "dist/cli.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "redbot": "node dist/cli.js",
    "test": "tsc && node --env-file=db/sqlite/.env.test db/sqlite/reset-test-db.mjs && node --env-file=db/sqlite/.env.test --test --test-concurrency=1 \"dist/test/*.test.js\" \"db/sqlite/schema.test.mjs\" \"db/sqlite/migrate-heal.test.mjs\" \"tools/operator/server.test.mjs\" \"tools/product/server.test.mjs\" \"electron/updater.test.mjs\" \"electron/vault-key.test.mjs\"",
    "test:ui": "node --env-file=db/sqlite/.env.test --test --test-timeout=180000 tools/product/ui.test.mjs",
    "test:smoke": "node --test --test-timeout=120000 electron/smoke.test.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:smoke",
    "db:migrate": "node db/sqlite/migrate.mjs up",
    "db:status": "node db/sqlite/migrate.mjs status",
    "db:verify": "node db/sqlite/migrate.mjs verify",
    "typecheck": "tsc --noEmit",
    "start": "tsc && electron .",
    "start:nobuild": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:dev": "npm run build && electron-builder --win nsis --publish never -c.appId=com.sgen.redbot.dev -c.productName=\"redbot dev\" -c.extraMetadata.productName=\"redbot dev\" -c.directories.output=release-dev"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.0"
  },
  "productName": "redbot",
  "main": "electron/main.mjs"
}
