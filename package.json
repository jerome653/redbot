{
  "name": "redbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "redbot MVP — assists a human engaging on Reddit through a real browser session. One account, one profile, local-first.",
  "engines": { "node": ">=20" },
  "bin": { "redbot": "dist/cli.js" },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "redbot": "node dist/cli.js",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
